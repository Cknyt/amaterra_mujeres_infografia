# Entorno Virtual Python
.venv/
venv/
ENV/
env/

# Byte-compiled / cachés de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# Sistema Operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos temporales y de bloqueo de Microsoft Office
~$*.xlsx
~$*.xls
~$*.pptx
~$*.ppt

# Carpeta de exportaciones generadas (conservando .gitkeep en subdirectorios)
exports/*
!exports/**/.gitkeep
!exports/.gitkeep

# Datos locales generados/procesados
data/processed/*
!data/processed/.gitkeep

# Secretos y variables de entorno
.env
.env.local
.streamlit/secrets.toml

# Configuraciones de IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
